# Copy this file to .env and adjust the values for your local LimeSurvey instance.
# Variables already set in the shell (e.g. in CI) take precedence over this file.

# LimeSurvey entry URL. Without URL rewriting, include the front controller:
#   BASE_URL=http://localhost:8080/index.php
BASE_URL=http://localhost:8080

# Super-administrator credentials used for the UI login and the RemoteControl API.
LS_ADMIN_USER=admin
LS_ADMIN_PASSWORD=password
